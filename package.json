{
  "name": "maestro",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:worker\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:worker": "npm run dev -w apps/agent-worker",
    "build": "npm run build -w packages/shared && npm run build -w apps/web && npm run build -w apps/agent-worker",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  }
}
