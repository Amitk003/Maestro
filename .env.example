# Supabase (required for auth and database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Worker URL (agent-worker address)
NEXT_PUBLIC_WORKER_URL=http://localhost:3001

# CORS origin for agent-worker (defaults to NEXT_PUBLIC_WORKER_URL or *)
CORS_ORIGIN=http://localhost:3000

# Redis (optional - for production agent state)
REDIS_URL=redis://localhost:6379

# Gemini API (optional - without it, heuristic fallback is used)
GEMINI_API_KEY=

# Weather API (optional - OpenWeatherMap)
WEATHER_API_KEY=
